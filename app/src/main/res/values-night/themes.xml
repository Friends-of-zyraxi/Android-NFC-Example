<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      深色模式的窗口主题。
      只覆盖与浅色不同的部分：系统栏图标明暗（窗口背景色由 values-night/colors.xml
      里的同名颜色资源自动切换）。
    -->
    <style name="BaseTheme_MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/fluent_canvas</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <!-- 深色窗口背景之上必须使用浅色系统栏图标，否则图标会与背景融为一体 -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.MyApplication" parent="BaseTheme_MyApplication" />
</resources>
